# S3 destination shared by the three ingestion jobs
IMAGE_TAG=latest
S3_BUCKET=smokecast-datalake-prod
AWS_REGION=us-east-1
# Vacío: los archivos se escriben directamente bajo el bucket.
S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# MySQL: fire_detections (container01-fires)
# Usa la IP privada o DNS de la MV de bases de datos.
FIRE_DB_HOST=10.0.0.10
FIRE_DB_PORT=3306
FIRE_DB_USER=root
FIRE_DB_PASSWORD=
FIRE_DB_NAME=db1_fire_catalog

# PostgreSQL: cities (container02-cities)
CITIES_DB_HOST=10.0.0.10
CITIES_DB_PORT=5432
CITIES_DB_USER=smokecast_admin
CITIES_DB_PASSWORD=
CITIES_DB_NAME=db2_urban_exposure

# MongoDB: weather_readings (container03-weather)
WEATHER_MONGO_HOST=10.0.0.10
WEATHER_MONGO_PORT=27017
WEATHER_MONGO_USER=
WEATHER_MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
WEATHER_MONGO_DB=db3_atmosphere_feed
WEATHER_MONGO_COLLECTION=weather_readings
