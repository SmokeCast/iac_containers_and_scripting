MYSQL_ROOT_PASSWORD=change-me
POSTGRES_USER=smokecast_admin
POSTGRES_PASSWORD=change-me
MONGO_ROOT_USERNAME=smokecast_admin
MONGO_ROOT_PASSWORD=change-me

# Nombre y versión de la imagen del seeder.
# Para una imagen publicada, cambia ambos valores y ejecuta `docker compose pull`.
SEED_IMAGE=empuiquin24/smokecast-seed
SEED_IMAGE_TAG=latest

SEED_DATABASE=all
SEED_FIRES=100000
SEED_WEATHER=100000
SEED_CITIES=1300
SEED_SITES=25000
