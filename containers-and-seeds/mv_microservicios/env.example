# Tag común de las imágenes publicadas en Docker Hub.
IMAGE_TAG=latest

# MS1 · Fire Catalog / MySQL
MYSQL_HOST=10.0.0.10
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=root

# MS2 · Urban Exposure / PostgreSQL
POSTGRES_HOST=10.0.0.10
POSTGRES_USER=smokecast_admin
POSTGRES_PASSWORD=change-me

# MS3 · Atmosphere Feed / MongoDB
MONGO_HOST=10.0.0.10
MONGO_ROOT_USERNAME=smokecast_admin
MONGO_ROOT_PASSWORD=change-me

# Prefijos públicos de Swagger/OpenAPI.
# Usa / para acceso directo local o /msN detrás de API Gateway.
MS1_PUBLIC_BASE_PATH=/
MS1_PUBLIC_OPENAPI_URL=openapi.json
# En AWS, usa /ms1 y /ms1/openapi.json respectivamente.
MS2_PUBLIC_BASE_PATH=/
MS3_PUBLIC_BASE_PATH=/
MS4_PUBLIC_BASE_PATH=/
MS5_PUBLIC_BASE_PATH=/

# Comunicación interna entre microservicios (MS3 y MS4)
MS1_URL=http://ms1:8081
MS2_URL=http://ms2:8082
MS3_URL=http://ms3:8083

# MS4 · Smoke Brain
REQUEST_TIMEOUT_MS=5000
RISK_RADIUS_KM=150

# MS5 · Analytics Gateway / Athena
ATHENA_ENABLED=false
AWS_REGION=us-east-1
ATHENA_DATABASE=smokecast_analytics
ATHENA_CATALOG=AwsDataCatalog
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_S3=
